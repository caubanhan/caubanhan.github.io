---
import Base from './Base.astro';
import Mark from '../components/Mark.astro';
const { frontmatter } = Astro.props;
---
<Base title={`${frontmatter.title} — nhan tran`} description={frontmatter.description}>
  <a class="corner c-tl" href="/" aria-label="về trang chủ"><Mark size={30} /></a>

  <article class="sheet">
    <div class="meta">{frontmatter.date}</div>
    <h1>{frontmatter.title}</h1>

    <div class="prose"><slot /></div>

    <div class="foot">nhan tran · <a href="/">trang chủ</a></div>
  </article>
</Base>
