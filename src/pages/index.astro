---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';

// Danh sách tự sinh từ thư mục — không phải sửa tay trang này nữa.
const posts = Object.values(import.meta.glob('./blog/*.md', { eager: true }))
  .sort((a, b) => b.frontmatter.date.localeCompare(a.frontmatter.date))
  .slice(0, 3);

const projects = Object.values(import.meta.glob('./work/*.md', { eager: true }))
  .sort((a, b) => a.frontmatter.order - b.frontmatter.order);

const social = [
  { label: 'GitHub', href: 'https://github.com/caubanhan' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nhantran21' },
];
---
<Base title="nhan tran">
  <canvas id="fx"></canvas>

  <div class="corner c-tl"><Mark /></div>
  <div class="corner c-tr" data-dust data-seq="11">v1.0.0</div>
  <div class="corner c-bl" data-dust data-seq="11">email: xabak4 at this site</div>
  <div class="corner c-br">
    {social.map((s, i) => (
      <a href={s.href} target="_blank" rel="me noopener" data-dust data-seq={12 + i}>{s.label}</a>
    ))}
  </div>

  <main class="page">
    <div class="body">
      <h1 class="hello"><span class="txt">Xin chào</span><span class="caret">_</span></h1>

      <section class="block">
        <div class="tag" data-dust data-seq="2">info.</div>
        <p class="bio" data-dust data-seq="3">
          I'm Nhan Tran, a network engineer and builder based in Ho Chi Minh City.
          I work on the layers nobody looks at until they fail — routing, transport, the
          quiet plumbing underneath. Then I build small tools so they stop failing quietly.
        </p>
      </section>

      <section class="block">
        <div class="tag" data-dust data-seq="5">work.</div>
        <div class="list">
          {projects.map((p, i) => (
            <a class={p.frontmatter.status === 'active' ? 'li' : 'li off'} href={p.url}>
              <span class="idx" data-dust data-seq={6 + i}>
                {String(p.frontmatter.order).padStart(3, '0')}
              </span>
              <span class="nm" data-dust data-seq={6 + i}>{p.frontmatter.title}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="block">
        <div class="tag" data-dust data-seq="8">log.</div>
        <div class="list dated">
          {posts.map((p, i) => (
            <a class="li" href={p.url}>
              <span class="idx" data-dust data-seq={9 + i}>{p.frontmatter.date}</span>
              <span class="nm" data-dust data-seq={9 + i}>{p.frontmatter.title}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>

  <script is:inline>
    // ── canvas: trường quanh con trỏ, vệt cát, chữ tụ từ bụi ──────
    (() => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const cv = document.getElementById('fx');
      const ctx = cv.getContext('2d', { alpha: true });
      const txtEl = document.querySelector('.hello .txt');
      let W = 0, H = 0, DPR = 1;

      const GRID = 12, GRID_OFF = 6;   // khớp chính xác với lưới chấm của CSS
      const FIELD_R = 112;             // bán kính con trỏ cảm được
      const MAX_GRAINS = 320;
      const SAND = ['#C6BCA9', '#B3A793', '#D5CDBE', '#9E9280', '#8C806D'];

      const pointer = { x: -1e4, y: -1e4, seen: false, last: -1e9 };
      const smooth = { x: -1e4, y: -1e4 };
      let grains = [], dust = [], headlineDone = false, cleared = false, built = false;

      function finishHeadline() {
        dust = [];
        headlineDone = true;
        txtEl.classList.remove('veiled');
      }

      function resize() {
        DPR = Math.min(devicePixelRatio || 1, 1.5);
        W = innerWidth; H = innerHeight;
        cv.width = W * DPR; cv.height = H * DPR;   // chỉ đổi bộ đệm, không đổi layout
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
        // dựng đúng MỘT lần. resize mà dựng lại thì hạt bị ném ra xa mãi,
        // và chữ không bao giờ tụ được.
        if (!built) { built = true; buildDust(); }
        else if (!headlineDone) finishHeadline();
      }

      function buildDust() {
        const r = txtEl.getBoundingClientRect();
        if (!r.width) return;
        const cs = getComputedStyle(txtEl);
        const PAD = 10, STEP = 3;
        const off = document.createElement('canvas');
        off.width = Math.ceil(r.width) + PAD * 2;
        off.height = Math.ceil(r.height) + PAD * 2;
        const g = off.getContext('2d', { willReadFrequently: true });
        g.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
        g.textBaseline = 'top';
        g.fillStyle = '#000';
        g.fillText(txtEl.textContent, PAD, PAD);

        const px = g.getImageData(0, 0, off.width, off.height).data;
        const next = [];
        for (let y = 0; y < off.height; y += STEP) {
          for (let x = 0; x < off.width; x += STEP) {
            if (px[(y * off.width + x) * 4 + 3] < 130) continue;
            const tx = r.left - PAD + x, ty = r.top - PAD + y;
            // hạt thổi tới từ dưới và từ hai bên, như cát trên đụn
            const a = Math.random() * Math.PI * 2, d = 90 + Math.random() * 250;
            next.push({
              tx, ty,
              x: tx + Math.cos(a) * d,
              y: ty + Math.sin(a) * d * 0.55 + 70,
              vx: 0, vy: 0,
              delay: 340 + Math.random() * 560,
              s: 1.3 + Math.random() * 0.9,
            });
          }
        }
        dust = next;
        txtEl.classList.add('veiled');
      }

      function emit(x, y, dx, dy) {
        const n = Math.min(5, 1 + ((Math.hypot(dx, dy) / 4) | 0));
        for (let i = 0; i < n; i++) {
          const a = Math.random() * Math.PI * 2, s = Math.random() * 1.5;
          grains.push({
            x: x + (Math.random() - 0.5) * 9,
            y: y + (Math.random() - 0.5) * 9,
            vx: Math.cos(a) * s + dx * 0.16,
            vy: Math.sin(a) * s + dy * 0.16,
            life: 1,
            decay: 0.007 + Math.random() * 0.01,
            s: 1 + Math.random() * 1.8,
            c: SAND[(Math.random() * SAND.length) | 0],
          });
        }
        if (grains.length > MAX_GRAINS) grains.splice(0, grains.length - MAX_GRAINS);
      }

      addEventListener('pointermove', (e) => {
        if (pointer.seen) emit(e.clientX, e.clientY, e.clientX - pointer.x, e.clientY - pointer.y);
        else { smooth.x = e.clientX; smooth.y = e.clientY; pointer.seen = true; }
        pointer.x = e.clientX; pointer.y = e.clientY; pointer.last = performance.now();
      }, { passive: true });

      let rt = 0;
      addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(resize, 150); });

      const T0 = performance.now();

      function tick(now) {
        // không có gì bay thì không vẽ gì cả. trang rảnh phải tốn 0 đồng.
        const live = now - pointer.last < 800;
        if (headlineDone && !grains.length && !live) {
          if (!cleared) { ctx.clearRect(0, 0, W, H); cleared = true; }
          return requestAnimationFrame(tick);
        }
        cleared = false;
        ctx.clearRect(0, 0, W, H);
        const t = now - T0;

        // con trỏ đi sau chuột một nhịp — chính độ trễ đó tạo cảm giác mượt
        smooth.x += (pointer.x - smooth.x) * 0.13;
        smooth.y += (pointer.y - smooth.y) * 0.13;

        if (live) {
          const i0 = Math.floor((smooth.x - FIELD_R - GRID_OFF) / GRID);
          const i1 = Math.ceil((smooth.x + FIELD_R - GRID_OFF) / GRID);
          const j0 = Math.floor((smooth.y - FIELD_R - GRID_OFF) / GRID);
          const j1 = Math.ceil((smooth.y + FIELD_R - GRID_OFF) / GRID);
          ctx.fillStyle = '#8C806D';
          for (let i = i0; i <= i1; i++) {
            for (let j = j0; j <= j1; j++) {
              const gx = GRID_OFF + i * GRID, gy = GRID_OFF + j * GRID;
              const dx = gx - smooth.x, dy = gy - smooth.y;
              const d = Math.hypot(dx, dy);
              if (d > FIELD_R) continue;
              const k = 1 - d / FIELD_R;
              const e = k * k * (3 - 2 * k);          // smoothstep
              const push = e * 3.4, inv = d ? 1 / d : 0;
              const sz = 2.1 + e * 2.6;
              ctx.globalAlpha = e * 0.5;
              ctx.fillRect(gx + dx * inv * push - sz / 2, gy + dy * inv * push - sz / 2, sz, sz);
            }
          }
        }

        for (let i = grains.length - 1; i >= 0; i--) {
          const p = grains[i];
          p.vx *= 0.962; p.vy *= 0.962; p.vy += 0.028;
          p.x += p.vx; p.y += p.vy;
          p.life -= p.decay;
          if (p.life <= 0) { grains.splice(i, 1); continue; }
          ctx.globalAlpha = p.life * p.life * 0.85;
          ctx.fillStyle = p.c;
          ctx.fillRect(p.x, p.y, p.s, p.s);
        }

        if (dust.length) {
          let moving = false;
          ctx.fillStyle = '#1B1A18';
          for (const p of dust) {
            if (t > p.delay) {
              p.vx += (p.tx - p.x) * 0.045; p.vy += (p.ty - p.y) * 0.045;
              p.vx *= 0.845; p.vy *= 0.845;
              p.x += p.vx; p.y += p.vy;
            }
            if (Math.abs(p.tx - p.x) + Math.abs(p.ty - p.y) > 0.4) moving = true;
            ctx.globalAlpha = Math.min(1, Math.max(0, (t - p.delay) / 520));
            ctx.fillRect(p.x, p.y, p.s, p.s);
          }
          if (!moving) finishHeadline();
        }

        ctx.globalAlpha = 1;
        requestAnimationFrame(tick);
      }

      // font phải sẵn sàng trước khi lấy mẫu chữ, không thì lấy nhầm font dự phòng
      (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => {
        resize();
        requestAnimationFrame(tick);
        // dù có chuyện gì, sau 4 giây chữ phải đọc được
        setTimeout(() => { if (!headlineDone) finishHeadline(); }, 4000);
      });
    })();
  </script>
</Base>
